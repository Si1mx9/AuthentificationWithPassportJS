<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up — AuthApp</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
  <%- include('_header') %>
  <main class="container">
    <div class="card">
      <h1>Create an account</h1>
      <p class="subtitle">Join us today — it's free</p>

      <form action="/sign-up" method="POST">
        <div class="form-group">
          <label for="username">Username</label>
          <input id="username" name="username" placeholder="Choose a username" type="text" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" name="password" placeholder="Choose a password" type="password" required />
        </div>
        <button type="submit" class="btn btn-primary">Create Account</button>
      </form>
      <div class="alt-link">
        Already have an account? <a href="/log-in">Log in</a>
      </div>
    </div>
  </main>
  <%- include('_footer') %>
</body>
</html>
